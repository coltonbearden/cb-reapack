{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "LLM bridge response, scripts/bridge/bridge.ps1 -> scripts/lib/bridge.lua (D-24, D-29). result has already passed schema/<action>.result.schema.json. usage is the provider's own; provider and cost are the bridge's record of the reply (D-94), present on an error too when the model answered.",
  "type": "object",
  "required": ["schema_version", "id", "status", "elapsed_ms"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ok", "error"] },
    "action": { "type": "string" },
    "model": { "type": "string" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "usage": { "type": "object" },
    "provider": { "enum": ["ollama", "anthropic", "offline"] },
    "cost": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "usd"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": ["number", "null"], "minimum": 0 },
        "price": {
          "type": ["object", "null"],
          "required": ["inputPerMTok", "outputPerMTok"],
          "properties": { "inputPerMTok": { "type": "number" }, "outputPerMTok": { "type": "number" } }
        }
      }
    },
    "result": { "type": "object" },
    "error": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "status": { "const": "ok" } } },
  "then": { "required": ["action", "model", "result"] },
  "else": { "required": ["error"] }
}
